# --- Python ---
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
*.so

# --- Virtual envs ---
.venv/
venv/
env/
.python-version

# --- Test / lint / type caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- CellFate-Rx run artefacts (datasets, bundles, reports are generated, not committed) ---
artifacts/
artefacts/
_cc_cache/
reports/
outputs/
*.parquet
*.ckpt

# --- LOOCV / step-6 fold builds. These land in the REPO ROOT because run_multi_local.py's
# ROOT is a relative path, where nothing above matched them -- 90.5 MB of bundles and model
# weights were committed by a `git add -A` on 2026-08-02 before these rules existed.
cellfate_loocv_*/
cellfate_multi*/
cellfate_step6_*/
cellfate_pf_*/
runs/
*.pt

# --- Experiment tracking / secrets ---
wandb/
.env
*.log

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Generated caches (re-downloaded on demand; see experiments/test_suite.py) ---
gene2vec_cache.txt

# --- Never commit archives of directories that are themselves committed ---
*.zip

# --- Stage 23.2H caches ---
# The clone pseudobulk matrix (35 MB) and its clone index are rebuilt in ~1.3 min by
# `run_stage23_2h_confirmation.py --stage 23.2h-b`. The simulation shards beside them are
# ~80 h of compute and ARE tracked.
results/.cache/*.npz
results/.cache/stage23_2h_clones.json

# --- Stage 24 tool artifact ---
# The serialized W5 model is 44 MB (five fold components + deployment, each carrying a PCA basis
# over ~18k retained genes). It rebuilds in ~0.5 min from committed inputs via
# `run_stage24_gen1_tool.py --stage 24c`, and its sha256 is recorded in the committed
# stage24_w5_artifact.json. For the reproducibility package it ships as a release asset.
results/stage24/stage24_w5_artifact.npz
